CLERK_SECRET_KEY=your_clerk_secret_key_here
DATABASE_URL=postgresql://truecover:truecover@localhost:5432/truecover
DOCKER_FN_PREVALENCE_URL=http://localhost:8084
DOCKER_FN_COVARIATE_URL=http://localhost:8082
DOCKER_FN_SAMPLING_URL=http://localhost:8083
FLASK_ENV=development
PORT=5000

# Overture Maps data source - can be remote URL or local file path
# Remote (slower, but always up-to-date):
# OVERTURE_BUILDINGS_PATH=az://overturemapswestus2.blob.core.windows.net/release/2025-10-22.0/theme=buildings/type=building/*
# Local cached (faster, run `python -m db.cache_overture_buildings` first):
OVERTURE_BUILDINGS_PATH=/path/to/parquet_cache/bd_buildings.parquet
