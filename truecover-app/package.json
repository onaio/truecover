  "scripts": {
    "dev": "react-scripts start",
    "start": "react-scripts start",
    "build": "react-scripts build",
    "docker:build": "docker build -t truecover-app:latest .",
    "docker:run": "docker run -d --name truecover-app -p 3030:80 --add-host=host.docker.internal:host-gateway truecover-app:latest",
    "docker:stop": "docker stop truecover-app && docker rm truecover-app",
    "docker:deploy": "npm run docker:build && npm run docker:stop; npm run docker:run",
    "test": "react-scripts test",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "http-proxy-middleware": "^3.0.5"
  }
}
